<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.uetlib</groupId>
        <artifactId>uetlib-parent</artifactId>
        <version>2026.11.1</version>
        <relativePath/>
    </parent>

    <artifactId>uetlib-payment-parent</artifactId>
    <version>4.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>uetlib-payment-parent</name>

    <description>Payment abstractions and provider integrations.</description>
    <url>https://github.com/UbiqueInnovation/uetlib-payment</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <organization>
        <name>Ubique Innovation AG</name>
        <url>https://www.ubique.ch</url>
    </organization>
    <developers>
        <developer>
            <name>Ubique Innovation AG</name>
            <organization>Ubique Innovation AG</organization>
            <organizationUrl>https://www.ubique.ch</organizationUrl>
        </developer>
    </developers>

    <properties>
        <!-- Sonar & Jacoco coverage reports -->
        <sonar.projectName>uetlib-payment</sonar.projectName>
        <sonar.coverage.module>uetlib-payment-coverage</sonar.coverage.module>
    </properties>

    <modules>
        <module>uetlib-payment</module>
        <module>uetlib-payment-datatrans</module>
        <module>uetlib-payment-postfinance</module>
        <module>uetlib-payment-coverage</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>4.1.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>2025.1.4</version>
            </dependency>

            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-payment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-core</artifactId>
                <version>3.0.1</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-spring-boot</artifactId>
                <version>4.0.2</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-spring-cloud</artifactId>
                <version>3.0.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <scm child.scm.url.inherit.append.path="false" child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false">
        <connection>scm:git:https://github.com/UbiqueInnovation/uetlib-payment.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/UbiqueInnovation/uetlib-payment.git</developerConnection>
        <url>https://github.com/UbiqueInnovation/uetlib-payment</url>
    </scm>
</project>
