<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.ubique</groupId>
        <artifactId>uetlib-parent</artifactId>
        <version>2026.9.3</version>
        <relativePath/>
    </parent>

    <artifactId>uetlib-payment-parent</artifactId>
    <version>3.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>uetlib-payment-parent</name>

    <properties>
        <!-- Sonar & Jacoco coverage reports -->
        <sonar.projectName>uetlib-payment</sonar.projectName>
        <sonar.coverage.module>uetlib-payment-coverage</sonar.coverage.module>
    </properties>

    <modules>
        <module>uetlib-payment</module>
        <module>uetlib-payment-datatrans</module>
        <module>uetlib-payment-postfinance</module>
        <module>uetlib-payment-coverage</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>4.1.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>2025.1.3</version>
            </dependency>

            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-payment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-core</artifactId>
                <version>2.5.2</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-spring-boot</artifactId>
                <version>3.1.0</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-spring-cloud</artifactId>
                <version>2.4.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <distributionManagement>
        <repository>
            <id>ubique-artifactory</id>
            <name>backend</name>
            <url>https://artifactory.ubique.ch/artifactory/backend</url>
        </repository>
    </distributionManagement>

        <repositories>
        <!-- ubique artifactory are necessary for resolution of the parent. -->
        <!-- Other repositories are resolved in the parent repositories. -->
        <repository>
            <id>ubique-artifactory</id>
            <name>backend</name>
            <url>https://artifactory.ubique.ch/artifactory/backend</url>
        </repository>
        <repository>
            <id>ubique-artifactory-virtual</id>
            <name>ubique</name>
            <url>https://artifactory.ubique.ch/artifactory/ubique</url>
        </repository>
    </repositories>

    <scm child.scm.url.inherit.append.path="false">
        <url>https://github.com/UbiqueInnovation/uetlib-payment</url>
    </scm>
</project>
